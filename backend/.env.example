# Banco de dados
DATABASE_URL="postgresql://iris:iris_dev_password@localhost:5432/iris_db?schema=public"

# Servidor
PORT=3333
NODE_ENV=development
TIMEZONE=America/Sao_Paulo

# Autenticação
